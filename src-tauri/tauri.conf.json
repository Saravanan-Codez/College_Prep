{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "EngiPrep",
  "version": "2.0.0",
  "identifier": "com.csprepos.desktop",
  "build": {
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "EngiPrep",
        "width": 1280,
        "height": 850,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self' asset:",
        "connect-src": "'self' ipc: http://ipc.localhost https://generativelanguage.googleapis.com",
        "font-src": "'self' https://fonts.gstatic.com https://cdnjs.cloudflare.com",
        "img-src": "'self' asset: http://asset.localhost blob: data: https://open.spotify.com",
        "style-src": "'self' 'unsafe-inline' https://fonts.googleapis.com https://cdnjs.cloudflare.com",
        "frame-src": "'self' https://open.spotify.com"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
